<?xml version='1.0' encoding='UTF-8'?>
<!--
  Minimal external consumer example: depends on the published com.viveworks.appbase 1.0.0
  coordinates from Maven Central, not on the Appbase reactor. Deliberately its own standalone
  Maven project (not a module of the root aggregator) so it resolves exactly the way a real
  external consumer would. Appbase#2545 RL-08/RL-11.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                      http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example.appbase</groupId>
    <artifactId>tasks-quickstart</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Appbase Tasks Quickstart</name>
    <description>
        Minimal external Maven project consuming the published Appbase 1.0.0 artifacts from
        Maven Central: a Reactor Netty embedded server exposing one Tasks REST resource backed
        by embedded JPA + H2.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <appbase.version>1.0.0</appbase.version>
        <hibernate.version>6.6.4.Final</hibernate.version>
        <h2.version>2.3.232</h2.version>
        <junit.version>5.11.3</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.viveworks.appbase</groupId>
                <artifactId>appbase-bom</artifactId>
                <version>${appbase.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Real, published Appbase 1.0.0 coordinates, resolved from Central via the BOM. -->
        <dependency>
            <groupId>com.viveworks.appbase</groupId>
            <artifactId>appbase-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.viveworks.appbase</groupId>
            <artifactId>appbase-bootstrap-reactor-netty</artifactId>
        </dependency>
        <dependency>
            <groupId>com.viveworks.appbase</groupId>
            <artifactId>appbase-service-core</artifactId>
        </dependency>

        <!-- Embedded JPA + H2, this example's own persistence, not an Appbase coordinate. -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${hibernate.version}</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>
