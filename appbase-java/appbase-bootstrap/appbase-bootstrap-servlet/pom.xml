<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.viveworks.appbase</groupId>
        <artifactId>appbase-bootstrap</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>appbase-bootstrap-servlet</artifactId>
    <name>Appbase Bootstrap Servlet</name>
    <description>Container-neutral servlet-API deployment and registration abstraction for Appbase bootstrap; consumed by the Jetty, Tomcat, and Undertow container implementations</description>
    <url>https://github.com/viveworks/Appbase/tree/develop/Java/${project.artifactId}</url>
    <scm><url>https://github.com/viveworks/Appbase/tree/develop/Java/${project.artifactId}</url></scm>
    <distributionManagement>
        <site><id>${project.artifactId}</id>
            <url>https://github.com/viveworks/Appbase/tree/develop/Java/${project.artifactId}</url></site>
    </distributionManagement>

    <dependencies>
        <dependency>
            <groupId>com.viveworks.appbase</groupId>
            <artifactId>appbase-bootstrap-core</artifactId>
            <version>${appbase.version}</version>
        </dependency>

        <!-- Servlet API spec only — no concrete container -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-integration-jakarta</artifactId>
        </dependency>
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-models-jakarta</artifactId>
        </dependency>
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-jaxrs2-jakarta</artifactId>
        </dependency>
        <!-- Swagger's Jakarta branch requests 3.0.1, while Hibernate and Jersey
             require 4.0.0. Select the upper bound for this servlet API graph. -->
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
            <version>4.0.0</version>
        </dependency>
        <!-- Swagger's legacy annotation introspection still loads javax JAXB on JDK 11+. -->
        <dependency>
            <groupId>javax.xml.bind</groupId>
            <artifactId>jaxb-api</artifactId>
            <version>2.3.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <archive><manifest>
                        <addClasspath>${archive.addClasspath}</addClasspath>
                        <addDefaultImplementationEntries>${archive.addDefaultImplementationEntries}</addDefaultImplementationEntries>
                        <addDefaultSpecificationEntries>${archive.addDefaultSpecificationEntries}</addDefaultSpecificationEntries>
                        <useUniqueVersions>${archive.useUniqueVersions}</useUniqueVersions>
                        <packageName>com.viveworks.appbase.bootstrap.servlet</packageName>
                    </manifest></archive>
                    <instructions>
                        <Export-Package>com.viveworks.appbase.bootstrap.servlet</Export-Package>
                        <Import-Package>!.,*</Import-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
