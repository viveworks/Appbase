<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.viveworks.appbase</groupId>
        <artifactId>appbase-bootstrap</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>appbase-bootstrap-reactor-netty</artifactId>
    <name>Appbase Bootstrap Reactor Netty</name>
    <description>Reactor-netty embedded non-blocking implementation of AppbaseWebServer</description>
    <url>https://github.com/viveworks/Appbase/tree/develop/Java/${project.artifactId}</url>
    <scm><url>https://github.com/viveworks/Appbase/tree/develop/Java/${project.artifactId}</url></scm>
    <distributionManagement>
        <site><id>${project.artifactId}</id>
            <url>https://github.com/viveworks/Appbase/tree/develop/Java/${project.artifactId}</url></site>
    </distributionManagement>

    <dependencies>
        <dependency>
            <groupId>com.viveworks.appbase</groupId>
            <artifactId>appbase-bootstrap-core</artifactId>
            <version>${appbase.version}</version>
        </dependency>
        <dependency>
            <groupId>com.viveworks.appbase</groupId>
            <artifactId>appbase-service-web</artifactId>
            <version>${appbase.version}</version>
        </dependency>
        <dependency>
            <groupId>io.projectreactor.netty</groupId>
            <artifactId>reactor-netty-http</artifactId>
        </dependency>
        <dependency>
            <groupId>io.projectreactor.tools</groupId>
            <artifactId>blockhound</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                      BlockHound rewrites JDK internals to detect blocking calls on non-blocking
                      threads. On JDK 13+ that needs AllowRedefinitionToAddDeleteMethods; on JDK 21+
                      the dynamic agent load warns without EnableDynamicAgentLoading.
                      @{argLine} preserves the JaCoCo agent that the root pom appends.
                    -->
                    <argLine>@{argLine} -XX:+AllowRedefinitionToAddDeleteMethods -XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <archive><manifest>
                        <addClasspath>${archive.addClasspath}</addClasspath>
                        <addDefaultImplementationEntries>${archive.addDefaultImplementationEntries}</addDefaultImplementationEntries>
                        <addDefaultSpecificationEntries>${archive.addDefaultSpecificationEntries}</addDefaultSpecificationEntries>
                        <useUniqueVersions>${archive.useUniqueVersions}</useUniqueVersions>
                        <packageName>com.viveworks.appbase.bootstrap.reactornetty</packageName>
                    </manifest></archive>
                    <instructions>
                        <Export-Package>com.viveworks.appbase.bootstrap.reactornetty.server,com.viveworks.appbase.bootstrap.reactornetty.configuration,com.viveworks.appbase.bootstrap.reactornetty.guice,com.viveworks.appbase.bootstrap.reactornetty.endpoint</Export-Package>
                        <Import-Package>!.,*</Import-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
