<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                      http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.viveworks.appbase</groupId>
        <artifactId>appbase-service</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>appbase-service-web-oauth-tokencache-aerospike</artifactId>
    <packaging>jar</packaging>
    <name>Appbase Service Web OAuth TokenCache Aerospike</name>
    <url>https://example.invalid/scratch-rehearsal/tree/develop/Java/${project.artifactId}</url>
    <scm>
        <url>https://example.invalid/scratch-rehearsal/tree/develop/Java/${project.artifactId}</url>
    </scm>
    <distributionManagement>
        <site>
            <id>${project.artifactId}</id>
            <url>https://example.invalid/scratch-rehearsal/tree/develop/Java/${project.artifactId}</url>
        </site>
    </distributionManagement>

    <dependencies>
        <!-- TokenCache SPI + the shared AbstractStoreBackedTokenCache clamp and ValidatedTokenCodec. -->
        <dependency>
            <groupId>com.viveworks.appbase</groupId>
            <artifactId>appbase-service-web-oauth</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The existing Aerospike client this backend stores tokens through. -->
        <dependency>
            <groupId>com.viveworks.appbase</groupId>
            <artifactId>appbase-client-aerospike</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- AerospikeTokenCacheIT uses the same ClientCoreTestHelper bootstrap and therefore needs
             the canonical client-core test resources on its own test classpath. -->
        <dependency>
            <groupId>com.viveworks.appbase</groupId>
            <artifactId>appbase-client-core</artifactId>
            <version>${project.version}</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-spring-security-keycloak</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.springframework.security:*</exclude>
                                        <exclude>org.keycloak:*</exclude>
                                    </excludes>
                                    <message>appbase-service-web-oauth-tokencache-aerospike stores validated tokens through the same SPIs: no hard dependency on Spring Security or Keycloak (P-020).</message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <packageName>com.viveworks.appbase.service.web.oauth.tokencache.aerospike</packageName>
                        </manifest>
                    </archive>
                    <instructions>
                        <Export-Package>com.viveworks.appbase.service.web.oauth.tokencache.aerospike.*</Export-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Opts this module into the failsafe IT execution defined in the parent's
            develop-profile/staging-profile/release-profile pluginManagement (version
            + executions). quick-profile never runs them.

            P-051 E1135 N05 (internal work item 1295). AerospikeTokenCacheIT is additionally gated behind
            @EnabledIfSystemProperty(named = "AerospikeClientServiceTests.enabled", matches = "true"),
            so an active profile alone does NOT reach for a live Aerospike; the explicit opt-in
            plus a running backend does.
        -->
        <profile>
            <id>develop-profile</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>staging-profile</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>release-profile</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
