<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                      http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.viveworks.appbase</groupId>
        <artifactId>appbase-service</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>appbase-service-web-oauth-github</artifactId>
    <packaging>jar</packaging>
    <name>Appbase Service Web OAuth GitHub</name>
    <url>https://github.com/viveworks/Appbase/tree/develop/Java/${project.artifactId}</url>
    <scm>
        <url>https://github.com/viveworks/Appbase/tree/develop/Java/${project.artifactId}</url>
    </scm>
    <distributionManagement>
        <site>
            <id>${project.artifactId}</id>
            <url>https://github.com/viveworks/Appbase/tree/develop/Java/${project.artifactId}</url>
        </site>
    </distributionManagement>

    <dependencies>
        <!-- GitHubOAuthFilter is a container-neutral servlet filter; the container supplies this API. -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- The validation core and SPIs (TokenValidator, TokenCache, ValidatedToken, TokenKeyHasher,
             CaffeineTokenCache). GitHub is not OIDC: it cannot reuse the Nimbus engine, but it implements
             the same TokenValidator seam and caches through the same TokenCache SPI (spec §5, §4.1). -->
        <dependency>
            <groupId>com.viveworks.appbase</groupId>
            <artifactId>appbase-service-web-oauth</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Parses the provider's /user JSON response into the validated claim set. The GitHub check is a
             network call, not a local JWT verification, so a JSON reader replaces the JOSE parser the
             OIDC providers get from Nimbus. Version is managed centrally (as in appbase-core). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-spring-security-keycloak</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.springframework.security:*</exclude>
                                        <exclude>org.keycloak:*</exclude>
                                    </excludes>
                                    <message>appbase-service-web-oauth-github validates opaque tokens against the provider's /user endpoint through the same SPIs: no hard dependency on Spring Security or Keycloak (P-020).</message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <packageName>com.viveworks.appbase.service.web.oauth.github</packageName>
                        </manifest>
                    </archive>
                    <instructions>
                        <Export-Package>com.viveworks.appbase.service.web.oauth.github.*</Export-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
