<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                      http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.viveworks.appbase</groupId>
        <artifactId>appbase-java</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>appbase-service</artifactId>
    <packaging>pom</packaging>
    <name>Appbase Service</name>
    <url>https://github.com/viveworks/Appbase/tree/develop/Java/${project.artifactId}</url>
    <scm>
        <url>https://github.com/viveworks/Appbase/tree/develop/Java/${project.artifactId}</url>
    </scm>
    <distributionManagement>
        <site>
            <id>${project.artifactId}</id>
            <url>https://github.com/viveworks/Appbase/tree/develop/Java/${project.artifactId}</url>
        </site>
    </distributionManagement>

    <modules>
        <module>appbase-service-core</module>
        <module>appbase-service-web</module>
        <module>appbase-service-web-oauth</module>
        <module>appbase-service-web-oauth-reactive</module>
        <module>appbase-service-web-oauth-google</module>
        <module>appbase-service-web-oauth-okta</module>
        <module>appbase-service-web-oauth-github</module>
        <module>appbase-service-web-oauth-microsoft</module>
        <module>appbase-service-web-oauth-apple</module>
        <module>appbase-service-web-oauth-tokencache-aerospike</module>
        <module>appbase-service-web-oauth-tokencache-redis</module>
        <module>appbase-service-user</module>
        <module>appbase-service-user-account-firebaseauth</module>
        <module>appbase-service-user-session-aerospike</module>
        <module>appbase-service-user-account-jdbi</module>
        <module>appbase-service-user-account-r2dbc</module>
        <module>appbase-service-supportmessage</module>
    </modules>

    <properties>
        <bouncycastle.version>1.80</bouncycastle.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Intra-service cross-module deps (versions not managed by root pom) -->
            <dependency>
                <groupId>com.viveworks.appbase</groupId>
                <artifactId>appbase-service-core</artifactId>
                <version>${appbase.version}</version>
            </dependency>
            <dependency>
                <groupId>com.viveworks.appbase</groupId>
                <artifactId>appbase-service-web</artifactId>
                <version>${appbase.version}</version>
            </dependency>
            <dependency>
                <groupId>com.viveworks.appbase</groupId>
                <artifactId>appbase-service-user</artifactId>
                <version>${appbase.version}</version>
            </dependency>
            <dependency>
                <groupId>com.viveworks.appbase</groupId>
                <artifactId>appbase-service-user-account-firebaseauth</artifactId>
                <version>${appbase.version}</version>
            </dependency>
            <dependency>
                <groupId>com.viveworks.appbase</groupId>
                <artifactId>appbase-service-user-session-aerospike</artifactId>
                <version>${appbase.version}</version>
            </dependency>
            <dependency>
                <groupId>com.viveworks.appbase</groupId>
                <artifactId>appbase-service-user-account-jdbi</artifactId>
                <version>${appbase.version}</version>
            </dependency>
            <dependency>
                <groupId>com.viveworks.appbase</groupId>
                <artifactId>appbase-service-user-account-r2dbc</artifactId>
                <version>${appbase.version}</version>
            </dependency>
            <dependency>
                <groupId>com.viveworks.appbase</groupId>
                <artifactId>appbase-service-supportmessage</artifactId>
                <version>${appbase.version}</version>
            </dependency>

            <!-- Client sub-module deps used by service sub-modules (versions not managed by root pom) -->
            <dependency>
                <groupId>com.viveworks.appbase</groupId>
                <artifactId>appbase-client-core</artifactId>
                <version>${appbase.version}</version>
            </dependency>
            <dependency>
                <groupId>com.viveworks.appbase</groupId>
                <artifactId>appbase-client-aerospike</artifactId>
                <version>${appbase.version}</version>
            </dependency>
            <dependency>
                <groupId>com.viveworks.appbase</groupId>
                <artifactId>appbase-client-cloud-aws-s3</artifactId>
                <version>${appbase.version}</version>
            </dependency>
            <dependency>
                <groupId>com.viveworks.appbase</groupId>
                <artifactId>appbase-client-firebase</artifactId>
                <version>${appbase.version}</version>
            </dependency>
            <dependency>
                <groupId>com.viveworks.appbase</groupId>
                <artifactId>appbase-client-jdbi</artifactId>
                <version>${appbase.version}</version>
            </dependency>
            <dependency>
                <groupId>com.viveworks.appbase</groupId>
                <artifactId>appbase-client-r2dbc</artifactId>
                <version>${appbase.version}</version>
            </dependency>
            <dependency>
                <groupId>com.viveworks.appbase</groupId>
                <artifactId>appbase-client-vitess</artifactId>
                <version>${appbase.version}</version>
            </dependency>
            <dependency>
                <groupId>com.viveworks.appbase</groupId>
                <artifactId>appbase-client-zookeeper</artifactId>
                <version>${appbase.version}</version>
            </dependency>

            <!-- Password Hashing (not managed by root pom) -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.felix</groupId>
                    <artifactId>maven-bundle-plugin</artifactId>
                    <version>${maven-bundle-plugin.version}</version>
                    <configuration>
                        <archive>
                            <manifest>
                                <addClasspath>
                                    ${archive.addClasspath}
                                </addClasspath>
                                <addDefaultImplementationEntries>
                                    ${archive.addDefaultImplementationEntries}
                                </addDefaultImplementationEntries>
                                <addDefaultSpecificationEntries>
                                    ${archive.addDefaultSpecificationEntries}
                                </addDefaultSpecificationEntries>
                                <useUniqueVersions>
                                    ${archive.useUniqueVersions}
                                </useUniqueVersions>
                            </manifest>
                        </archive>
                        <instructions>
                            <Import-Package>!.,*</Import-Package>
                        </instructions>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
