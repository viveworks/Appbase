<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                      http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.viveworks.appbase</groupId>
        <artifactId>appbase-service</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>appbase-service-web-oauth</artifactId>
    <packaging>jar</packaging>
    <name>Appbase Service Web OAuth</name>
    <url>https://example.invalid/scratch-rehearsal/tree/develop/Java/${project.artifactId}</url>
    <scm>
        <url>https://example.invalid/scratch-rehearsal/tree/develop/Java/${project.artifactId}</url>
    </scm>
    <distributionManagement>
        <site>
            <id>${project.artifactId}</id>
            <url>https://example.invalid/scratch-rehearsal/tree/develop/Java/${project.artifactId}</url>
        </site>
    </distributionManagement>

    <dependencies>
        <!-- Servlet API is provided by the web container; the OAuth filter compiles against it only. -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Built-in in-memory TokenCache backend (the ServiceLoader default). -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!-- Nimbus JOSE + JWT: the local JWKS/JWT validation engine (JWKSourceBuilder,
             DefaultJWTProcessor). No per-request round trip to the provider. -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
        </dependency>
        <!-- Serializes a ValidatedToken to bytes for the external (Aerospike/Redis) TokenCache backends
             via ValidatedTokenCodec; the in-memory Caffeine default keeps objects and never touches it
             (managed by the root jackson-bom; no version here). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Publish the test fixtures (JwksTestServer + the loopback JWKS/TLS keystore and RS256
                 signing helpers) as a test-jar so the provider modules (N04-N07) validate a
                 provider-shaped token against the identical offline fixture instead of duplicating it. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>test-jar</id>
                        <goals><goal>test-jar</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-spring-security-keycloak</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.springframework.security:*</exclude>
                                        <exclude>org.keycloak:*</exclude>
                                    </excludes>
                                    <message>appbase-service-web-oauth validates tokens locally with Nimbus: no hard dependency on Spring Security or Keycloak (P-020).</message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <packageName>com.viveworks.appbase.service.web.oauth</packageName>
                        </manifest>
                    </archive>
                    <instructions>
                        <Export-Package>com.viveworks.appbase.service.web.oauth.*</Export-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
