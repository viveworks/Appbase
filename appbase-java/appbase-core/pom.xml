        <!--
          BlockHound proves the reactive read path never blocks a non-blocking scheduler; reactor-test
          drives the harness assertions. Versions are managed by the root pom (blockhound.version) and
          the Reactor BOM. Exercised only by the isolated `blockhound-test` surefire execution below.
        -->
        <dependency>
            <groupId>io.projectreactor.tools</groupId>
            <artifactId>blockhound</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>


    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <DefaultTracerServiceTest.testRemoteReporter>false</DefaultTracerServiceTest.testRemoteReporter>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <!--
                      The default fork EXCLUDES every BlockHound harness (**/*BlockHoundTest.java, not
                      just today's one class; the epic's N01 plan anticipates a second). BlockHound's
                      install() is JVM-global, so once armed it instruments every later test in the
                      same fork; this core suite is order-sensitive (shared H2 / Lucene fixtures), so
                      the harnesses run in their own fork (below) rather than tainting the rest.
                    -->
                    <execution>
                        <id>default-test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>**/*BlockHoundTest.java</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <!--
                      The BlockHound harnesses (**/*BlockHoundTest.java), isolated in their own fork.
                      BlockHound rewrites JDK internals to detect blocking on non-blocking threads; on
                      JDK 13+ that needs AllowRedefinitionToAddDeleteMethods, and on JDK 21+ the dynamic
                      agent load warns without EnableDynamicAgentLoading. @{argLine} preserves the
                      JaCoCo agent that the root pom appends. BlockHound 1.0.13 is the first release
                      that instruments on JDK 25.
                    -->
                    <execution>
                        <id>blockhound-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*BlockHoundTest.java</include>
                            </includes>
                            <argLine>@{argLine} -XX:+AllowRedefinitionToAddDeleteMethods -XX:+EnableDynamicAgentLoading</argLine>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <version>${maven-bundle-plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>
                                ${archive.addClasspath}
                            </addClasspath>
                            <addDefaultImplementationEntries>
                                ${archive.addDefaultImplementationEntries}
                            </addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>
                                ${archive.addDefaultSpecificationEntries}
                            </addDefaultSpecificationEntries>
                            <useUniqueVersions>
                                ${archive.useUniqueVersions}
                            </useUniqueVersions>
                            <packageName>com.viveworks.appbase.core</packageName>
                        </manifest>
                    </archive>
                    <instructions>
                        <Import-Package>!.,*</Import-Package>
                        <Export-Package>com.viveworks.appbase.core</Export-Package>
                        <Export-Service>
                            com.viveworks.appbase.core.service.log.LogService,
                            com.viveworks.appbase.core.service.mediator.MediatorService,
                            com.viveworks.appbase.core.service.metric.MetricService,
                            com.viveworks.appbase.core.service.reactive.reactor.ReactorService,
                            com.viveworks.appbase.core.service.registry.ServiceRegistry,
                            com.viveworks.appbase.core.service.tracer.TracerService,
                            com.viveworks.appbase.core.service.validation.ValidationService
                        </Export-Service>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
