<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                      http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.viveworks.appbase</groupId>
        <artifactId>appbase-client</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>appbase-client-vitess</artifactId>
    <packaging>jar</packaging>
    <name>Appbase Client Vitess</name>
    <url>https://github.com/viveworks/Appbase/tree/develop/Java/${project.artifactId}</url>
    <scm>
        <url>https://github.com/viveworks/Appbase/tree/develop/Java/${project.artifactId}</url>
    </scm>
    <distributionManagement>
        <site>
            <id>${project.artifactId}</id>
            <url>https://github.com/viveworks/Appbase/tree/develop/Java/${project.artifactId}</url>
        </site>
    </distributionManagement>

    <dependencies>
        <dependency>
            <groupId>com.viveworks.appbase</groupId>
            <artifactId>appbase-client-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vitess</groupId>
            <artifactId>vitess-grpc-client</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vitess</groupId>
            <artifactId>vitess-jdbc</artifactId>
        </dependency>
        <!-- Test-only: vitess tests cross-reference jdbc and jasync classes -->
        <dependency>
            <groupId>com.viveworks.appbase</groupId>
            <artifactId>appbase-client-jdbc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.viveworks.appbase</groupId>
            <artifactId>appbase-client-jdbc</artifactId>
            <version>${appbase.version}</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.viveworks.appbase</groupId>
            <artifactId>appbase-client-jasync</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.viveworks.appbase</groupId>
            <artifactId>appbase-client-jasync</artifactId>
            <version>${appbase.version}</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
        <!-- reactor-core itself is not declared here: it already resolves transitively as a
             compile-scoped dependency of appbase-client-core (same pattern followed by
             appbase-client-cassandra/appbase-client-cloud-aws-s3, which also omit an explicit
             reactor-core entry). -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test-only (internal work item 503): appbase-core.yaml for ClientCoreTestHelper, from the core test-jar -->
        <dependency>
            <groupId>com.viveworks.appbase</groupId>
            <artifactId>appbase-client-core</artifactId>
            <version>${appbase.version}</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <packageName>com.viveworks.appbase.client.service.vitess</packageName>
                        </manifest>
                    </archive>
                    <instructions>
                        <Export-Package>com.viveworks.appbase.client.service.vitess,com.viveworks.appbase.client.service.vitess.accessor,com.viveworks.appbase.client.service.vitess.accessor.reactive</Export-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Opts this module into the failsafe IT execution defined in the parent's
            develop-profile/staging-profile/release-profile pluginManagement (version
            + executions). Since Maven merges same-id profiles across POMs in the
            reactor, declaring one profile per id here causes failsafe to run
            *IT.java tests during the verify phase whenever any of those 3 profiles
            is active; quick-profile never runs them.
        -->
        <profile>
            <id>develop-profile</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>staging-profile</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>release-profile</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
