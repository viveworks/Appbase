<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                      http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.viveworks.appbase</groupId>
        <artifactId>appbase-client</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>appbase-client-smtp</artifactId>
    <packaging>jar</packaging>
    <name>Appbase Client SMTP</name>
    <url>https://github.com/viveworks/Appbase/tree/develop/Java/${project.artifactId}</url>
    <scm>
        <url>https://github.com/viveworks/Appbase/tree/develop/Java/${project.artifactId}</url>
    </scm>
    <distributionManagement>
        <site>
            <id>${project.artifactId}</id>
            <url>https://github.com/viveworks/Appbase/tree/develop/Java/${project.artifactId}</url>
        </site>
    </distributionManagement>

    <dependencies>
        <dependency>
            <groupId>com.viveworks.appbase</groupId>
            <artifactId>appbase-client-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hubspot</groupId>
            <artifactId>NioSmtpClient</artifactId>
        </dependency>
        <!--
          Test-only (AUD-502): NioSmtpClient's EhloResponse static initializer references Guava's
          CharMatcher.WHITESPACE field, which the reactor's managed Guava 33.x no longer has, so
          every EhloResponse path (including this module's gated live-server tests) previously
          threw NoSuchFieldError on the test classpath. Pin, for tests only, the newest Guava
          that still carries the field so SMTP AUTH coverage can run at all. Compile and runtime
          scopes keep the reactor-managed version.
        -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>25.0-jre</version>
            <scope>test</scope>
        </dependency>
        <!-- Test-only (internal work item 503): appbase-core.yaml for ClientCoreTestHelper, from the core test-jar -->
        <dependency>
            <groupId>com.viveworks.appbase</groupId>
            <artifactId>appbase-client-core</artifactId>
            <version>${appbase.version}</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <packageName>com.viveworks.appbase.client.service.smtp</packageName>
                        </manifest>
                    </archive>
                    <instructions>
                        <Export-Package>com.viveworks.appbase.client.service.smtp</Export-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
