<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                      http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.viveworks.appbase</groupId>
        <artifactId>appbase-java</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>appbase-client</artifactId>
    <packaging>pom</packaging>
    <name>Appbase Client</name>
    <url>https://github.com/viveworks/Appbase/tree/develop/Java/${project.artifactId}</url>
    <scm>
        <url>https://github.com/viveworks/Appbase/tree/develop/Java/${project.artifactId}</url>
    </scm>
    <distributionManagement>
        <site>
            <id>${project.artifactId}</id>
            <url>https://github.com/viveworks/Appbase/tree/develop/Java/${project.artifactId}</url>
        </site>
    </distributionManagement>

    <modules>
        <module>appbase-client-core</module>
        <module>appbase-client-aerospike</module>
        <module>appbase-client-cassandra</module>
        <module>appbase-client-clamav</module>
        <module>appbase-client-cloud</module>
        <module>appbase-client-druid</module>
        <module>appbase-client-elasticsearch</module>
        <module>appbase-client-firebase</module>
        <module>appbase-client-jasync</module>
        <module>appbase-client-jdbc</module>
        <module>appbase-client-jdbi</module>
        <module>appbase-client-jpa</module>
        <module>appbase-client-kafka</module>
        <module>appbase-client-r2dbc</module>
        <module>appbase-client-redis</module>
        <module>appbase-client-smtp</module>
        <module>appbase-client-spark</module>
        <module>appbase-client-vitess</module>
        <module>appbase-client-zookeeper</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Intra-client cross-module deps (versions not managed by root pom) -->
            <dependency>
                <groupId>com.viveworks.appbase</groupId>
                <artifactId>appbase-client-core</artifactId>
                <version>${appbase.version}</version>
            </dependency>
            <dependency>
                <groupId>com.viveworks.appbase</groupId>
                <artifactId>appbase-client-jdbc</artifactId>
                <version>${appbase.version}</version>
            </dependency>
            <dependency>
                <groupId>com.viveworks.appbase</groupId>
                <artifactId>appbase-client-jasync</artifactId>
                <version>${appbase.version}</version>
            </dependency>
            <dependency>
                <groupId>com.viveworks.appbase</groupId>
                <artifactId>appbase-client-r2dbc</artifactId>
                <version>${appbase.version}</version>
            </dependency>
            <dependency>
                <groupId>com.viveworks.appbase</groupId>
                <artifactId>appbase-client-vitess</artifactId>
                <version>${appbase.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <systemPropertyVariables>
                            <AerospikeClientServiceTests.enabled>false</AerospikeClientServiceTests.enabled>
                            <CassandraClientServiceTests.enabled>false</CassandraClientServiceTests.enabled>
                            <ClamAVClientServiceTests.enabled>false</ClamAVClientServiceTests.enabled>
                            <DruidClientServiceTests.enabled>false</DruidClientServiceTests.enabled>
                            <ElasticsearchClientServiceTests.enabled>false</ElasticsearchClientServiceTests.enabled>
                            <FirebaseAuthClientServiceTests.enabled>false</FirebaseAuthClientServiceTests.enabled>
                            <JasyncClientServiceTests.enabled>false</JasyncClientServiceTests.enabled>
                            <JdbcClientServiceTests.enabled>false</JdbcClientServiceTests.enabled>
                            <JdbiClientServiceTests.enabled>false</JdbiClientServiceTests.enabled>
                            <JpaClientServiceTests.enabled>false</JpaClientServiceTests.enabled>
                            <KafkaClientServiceTests.enabled>false</KafkaClientServiceTests.enabled>
                            <R2dbcClientServiceTests.enabled>false</R2dbcClientServiceTests.enabled>
                            <RedisClientServiceTests.enabled>false</RedisClientServiceTests.enabled>
                            <S3ClientServiceTests.enabled>false</S3ClientServiceTests.enabled>
                            <SmtpClientServiceTests.enabled>false</SmtpClientServiceTests.enabled>
                            <SparkClientServiceTests.enabled>false</SparkClientServiceTests.enabled>
                            <VitessClientServiceTests.enabled>false</VitessClientServiceTests.enabled>
                            <ZooKeeperClientServiceTests.enabled>false</ZooKeeperClientServiceTests.enabled>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.felix</groupId>
                    <artifactId>maven-bundle-plugin</artifactId>
                    <version>${maven-bundle-plugin.version}</version>
                    <configuration>
                        <archive>
                            <manifest>
                                <addClasspath>
                                    ${archive.addClasspath}
                                </addClasspath>
                                <addDefaultImplementationEntries>
                                    ${archive.addDefaultImplementationEntries}
                                </addDefaultImplementationEntries>
                                <addDefaultSpecificationEntries>
                                    ${archive.addDefaultSpecificationEntries}
                                </addDefaultSpecificationEntries>
                                <useUniqueVersions>
                                    ${archive.useUniqueVersions}
                                </useUniqueVersions>
                            </manifest>
                        </archive>
                        <instructions>
                            <Import-Package>!.,*</Import-Package>
                        </instructions>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
